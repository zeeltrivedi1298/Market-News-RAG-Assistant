# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
LLM_MODEL=gpt-3.5-turbo

# Embedding Configuration (free, local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Fallback Model Configuration
# LLM fallback model (defaults to primary model if not specified)
LLM_FALLBACK_MODEL=
# Embedding fallback model
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Enable fallback models (true/false)
ENABLE_LLM_FALLBACK=true
ENABLE_EMBEDDING_FALLBACK=true

# Retry and Exponential Backoff Configuration
# Maximum number of retry attempts
MAX_RETRIES=3
# Initial delay before first retry (seconds)
INITIAL_RETRY_DELAY=1.0
# Exponential backoff multiplier
BACKOFF_FACTOR=2.0
# Maximum delay between retries (seconds)
MAX_RETRY_DELAY=60.0

# Vector Store Configuration
CHROMA_PERSIST_DIR=./chroma_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
# Enable Gradio public share link (creates temporary public URL)
GRADIO_SHARE=false

# Logging Configuration
LOG_LEVEL=INFO

# Chunking Configuration (2025 best practices: token-based)
# Chunk size in tokens (recommended: 300-600 tokens for blogs/docs)
CHUNK_SIZE_TOKENS=400
# Chunk overlap in tokens (recommended: 10-20% of chunk size)
CHUNK_OVERLAP_TOKENS=60

# Advanced Retrieval Configuration
# Enable hybrid search (combines vector search with BM25 keyword search)
USE_HYBRID_SEARCH=false
# Weight for vector search in hybrid mode (0.0 = only BM25, 1.0 = only vector, 0.5 = equal)
HYBRID_SEARCH_ALPHA=0.5
# Semantic chunking is always enabled (requires scikit-learn)
# Reranking is always enabled (uses flashrank)
# Multiplier for documents to retrieve before reranking (e.g., 2 = retrieve 2x k, then rerank to top k)
RERANK_TOP_K_MULTIPLIER=2

